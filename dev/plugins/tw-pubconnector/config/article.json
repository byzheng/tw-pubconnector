{
        "wiley.com": {
            "articleSelector": "div#article__content",
            "removeSelectors": [
                "div.stickybar__wrapper"
            ],
            "classRemovals": [
                {
                    "selector": "div#article__content",
                    "classes": [
                        "col-sm-12", "col-md-8", "col-lg-8"
                    ]
                }
            ]
        },
        "sciencedirect.com": {
            "articleSelector": "article",
            "classRemovals": [
                {
                    "selector": "article",
                    "classes": ["col-md-16", "col-lg-12"]
                }
            ]
        }, 
        "publish.csiro.au": {
            "articleSelector": "section.region-main-content",
            "removeSelectors": [
                "div.journal-body"
            ]
        },
        "springer.com": {
            "articleSelector": "article#main",
              "removeSelectors": [
                "section[aria-labelledby='inline-recommendations']",
                "section[aria-labelledby='content-related-subjects']",
                "div[data-test='article-metrics']",
                "section[aria-labelledby='article-info']"
            ]
        },
        "pnas.org": {
            "articleSelector": "article[data-type='research-article']",
            "removeSelectors": [
                "nav#article_sections_menu",
                "aside.core-special-feature",
                "div[data-core-nav='header']",
                "div.share__block"
            ]
        },
        "frontiersin.org": {
            "articleSelector": "main",
            "removeSelectors": [
                "div#header",
                "div#footer"
            ]
        },
        "oup.com": {
            "articleSelector": "div.content-inner-wrap",
            "removeSelectors": [
            ]
        }
}
